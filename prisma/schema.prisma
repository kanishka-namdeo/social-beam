generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AnalyticsSnapshot {
  id             String   @id
  postId         String
  platform       String
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  impressions    Int      @default(0)
  engagementRate Float?
  snapshotAt     DateTime @default(now())
  clicks         Int      @default(0)
  profileVisits  Int      @default(0)
  reach          Int      @default(0)
  saves          Int      @default(0)
  videoViews     Int      @default(0)
  websiteClicks  Int      @default(0)
  Post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model BrandContext {
  id                  String                @id
  workspaceId         String                @unique
  businessName        String?
  tagline             String?
  websiteUrl          String?
  industry            String?
  productDesc         String?
  tonePreset          String?
  voiceDescription    String?
  bannedWords         String[]
  voiceExamples       Json?
  audienceType        String?
  demographics        Json?
  interests           String[]
  painPoints          String[]
  competitors         String[]
  goals               String[]
  trainingStatus      String                @default("untrained")
  lastTrainedAt       DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  Workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  BrandContextVersion BrandContextVersion[]
  BrandFieldState     BrandFieldState[]
  BrandLearningSignal BrandLearningSignal[]
  PlatformContext     PlatformContext[]

  @@index([workspaceId])
}

model BrandContextVersion {
  id               String       @id
  brandContextId   String
  snapshot         Json
  changeReason     String?
  platformSnapshot Json?
  createdAt        DateTime     @default(now())
  BrandContext     BrandContext @relation(fields: [brandContextId], references: [id], onDelete: Cascade)

  @@index([brandContextId])
  @@index([createdAt])
}

model BrandFieldState {
  id             String       @id
  brandContextId String
  fieldName      String
  currentValue   Json
  confidence     Float        @default(0.5)
  stability      Int          @default(0)
  signalCount    Int          @default(0)
  lastUpdated    DateTime     @default(now())
  BrandContext   BrandContext @relation(fields: [brandContextId], references: [id], onDelete: Cascade)

  @@unique([brandContextId, fieldName])
}

model BrandLearningSignal {
  id             String       @id
  brandContextId String
  signalType     String
  sourcePostId   String?
  fieldName      String
  direction      String
  magnitude      Float
  confidence     Float
  createdAt      DateTime     @default(now())
  applied        Boolean      @default(false)
  metadata       Json?
  BrandContext   BrandContext @relation(fields: [brandContextId], references: [id], onDelete: Cascade)

  @@index([brandContextId, fieldName])
  @@index([brandContextId, signalType])
  @@index([createdAt])
}

model BrandVoice {
  id          String    @id
  workspaceId String    @unique
  tonePreset  String?
  description String?
  examples    Json      @default("[]")
  perPlatform Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ConnectedAccount {
  id               String    @id
  workspaceId      String
  platform         String
  platformUserId   String
  accessToken      String
  refreshToken     String
  tokenExpiry      DateTime?
  status           String    @default("connected")
  createdAt        DateTime  @default(now())
  avatarUrl        String?
  followerCount    Int?
  lastRefreshAt    DateTime?
  lastSyncedAt     DateTime?
  platformUsername String?
  sourcePlatform   String?
  cookieExpiry     DateTime?
  sessionCookie    String?
  Workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform])
}

model DashboardPreference {
  id          String    @id
  workspaceId String    @unique
  layout      Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model EngagementItem {
  id             String           @id
  workspaceId    String
  platform       String
  type           EngagementType
  platformItemId String
  platformUrl    String?
  authorName     String?
  authorAvatar   String?
  content        String
  parentContent  String?
  parentId       String?
  inReplyToId    String?
  status         EngagementStatus @default(UNREAD)
  sentiment      String?
  aiDraft        String?
  createdAt      DateTime         @default(now())
  syncedAt       DateTime         @default(now())
  repliedAt      DateTime?
  Workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platformItemId])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, platform])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
}

model FollowerSnapshot {
  id          String   @id
  workspaceId String
  platform    String
  followers   Int      @default(0)
  following   Int      @default(0)
  snapshotAt  DateTime @default(now())

  @@index([workspaceId, platform, snapshotAt])
}

model MediaAsset {
  id           String    @id
  workspaceId  String
  originalName String
  mimeType     String
  fileSize     Int
  width        Int
  height       Int
  storagePath  String
  publicUrl    String
  status       String    @default("active")
  variants     Json?     @default("[]")
  tags         String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  Workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model Subscription {
  id                     String           @id
  userId                 String
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripePriceId          String?
  plan                   String           @default("free")
  tier                   SubscriptionTier @default(FREE)
  status                 String           @default("active")
  currentPeriodEnd       DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  User                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([stripeCustomerId])
}

model OnboardingSession {
  id          String    @id
  userId      String    @unique
  currentStep String    @default("greeting")
  stepData    Json?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model PlatformContext {
  id              String       @id
  brandContextId  String
  platform        String
  platformTone    String?
  contentMix      Json?
  postingCadence  String?
  hashtagStrategy Json?
  visualStyle     String?
  engagementStyle String?
  platformRules   String[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  BrandContext    BrandContext @relation(fields: [brandContextId], references: [id], onDelete: Cascade)

  @@unique([brandContextId, platform])
  @@index([brandContextId])
}

model Post {
  id                String              @id
  workspaceId       String
  title             String?
  content           Json
  status            PostStatus          @default(DRAFT)
  confidence        ConfidenceLevel?
  scheduledAt       DateTime?
  publishedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  isExternal        Boolean             @default(false)
  AnalyticsSnapshot AnalyticsSnapshot[]
  Workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  PostPlatform      PostPlatform[]
}

model PostPlatform {
  id           String     @id
  postId       String
  platform     String
  content      String
  mediaUrls    Json?      @default("[]")
  status       PostStatus @default(DRAFT)
  externalId   String?
  error        String?
  createdAt    DateTime   @default(now())
  postUrl      String?
  analyticsUrl String?
  Post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model RedditSubredditConfig {
  id          String    @id
  workspaceId String
  subreddit   String
  sortOrder   String    @default("hot")
  isActive    Boolean   @default(true)
  source      String    @default("manual")   // "manual" | "recommended" | "default"
  relevanceScore Float?                       // AI-assigned relevance 0-1 for recommended ones
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, subreddit])
  @@index([workspaceId])
}

model RedditTrendingPost {
  id              String    @id
  workspaceId     String
  subreddit       String
  title           String
  url             String
  author          String
  upvotes         Int       @default(0)
  commentCount    Int       @default(0)
  scrapedAt       DateTime  @default(now())
  relevanceScore  Float?
  relevanceReason String?
  isActionable    Boolean   @default(false)
  topicTags       String[]
  suggestedAction String?
  actedOnAt       DateTime?
  dismissedAt     DateTime?
  postId          String?
  riskLevel       String    @default("low")
  riskReason      String?
  sentiment       String    @default("neutral")
  brandReasonTags String[]
  Workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, dismissedAt])
  @@index([workspaceId, postId])
  @@index([workspaceId, relevanceScore])
  @@index([workspaceId, scrapedAt])
}

model SavedReply {
  id          String    @id
  workspaceId String
  title       String
  content     String
  tags        String[]
  platform    String?
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model User {
  id               String         @id
  email            String         @unique
  name             String?
  password         String
  role             UserRole       @default(FREE_USER)
  lastRoleChangeAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  UserOAuthApp     UserOAuthApp[]
  Workspace        Workspace[]
  Subscription     Subscription?
}

model UserOAuthApp {
  id           String   @id
  userId       String
  platform     String
  clientId     String
  clientSecret String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model UserProfile {
  id            String    @id
  workspaceId   String    @unique
  bio           Json?
  tone          String?
  postTypes     Json?
  imageAnalysis Json?
  audience      Json?
  createdAt     DateTime  @default(now())
  Workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Workspace {
  id                    String                  @id
  userId                String
  name                  String                  @default("My Workspace")
  autonomyLevel         String                  @default("suggestions")
  createdAt             DateTime                @default(now())
  BrandContext          BrandContext?
  BrandVoice            BrandVoice?
  ConnectedAccount      ConnectedAccount[]
  DashboardPreference   DashboardPreference?
  EngagementItem        EngagementItem[]
  MediaAsset            MediaAsset[]
  Post                  Post[]
  RedditSubredditConfig RedditSubredditConfig[]
  RedditTrendingPost    RedditTrendingPost[]
  SavedReply            SavedReply[]
  UserProfile           UserProfile?
  User                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String @default("")
  channel       String
  version       String
  type          String
  blob          Bytes?

  @@id([thread_id, checkpoint_ns, channel, version])
}

model checkpoint_migrations {
  v Int @id
}

model checkpoint_writes {
  thread_id     String
  checkpoint_ns String  @default("")
  checkpoint_id String
  task_id       String
  idx           Int
  channel       String
  type          String?
  blob          Bytes

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String  @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String?
  checkpoint           Json
  metadata             Json    @default("{}")

  @@id([thread_id, checkpoint_ns, checkpoint_id])
}

enum SubscriptionTier {
  FREE
  AI_STARTER
  AI_PRO
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum EngagementStatus {
  UNREAD
  READ
  REPLIED
  DISMISSED
}

enum EngagementType {
  COMMENT
  MENTION
  DM
}

enum UserRole {
  ADMIN
  FREE_USER
  PREMIUM_USER
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  EXTERNAL
}
